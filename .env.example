# AXIMA Znalostní Asistent — vzor konfigurace.
# Zkopírujte na .env a doplňte hodnoty. .env se NIKDY necommituje.
#
# POZOR: řada konstant (modely, limit, threshold, URL) je dnes natvrdo v kódu
# (api.py / watchdog_service.py) a z .env se NEČTE — sjednocení je v backlogu
# (viz docs/HANDOFF.md). Reálně používané proměnné prostředí jsou označeny [ČTE SE].

# --- Přihlášení: Microsoft Entra ID (SSO) --- [ČTE SE] (api.py)
# Registrace aplikace v Azure Portal → App registrations.
# Redirect URI nastavte na https://SERVER/api/auth/callback
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=__zmen_me__
# Náhodný silný řetězec pro podpis session cookie (např. `openssl rand -hex 32`)
SESSION_SECRET=__zmen_me__

# --- Ingest (reconciliation sken) --- [ČTE SE] (watchdog_service.py)
# Interval skenu v sekundách (prod doporučeno 900, dev default 30).
RECONCILIATION_INTERVAL_SEC=900
# Fallback hlídaných cest, když neběží API (jinak se čtou z monitored_paths.json
# přes GET /api/monitored_paths). Oddělené čárkou; UNC ve tvaru //server/share/...
MONITORED_PATHS=/data/llm-demo/watchdog/incoming

# --- Kerberos ccache pro user-space SMB --- (nastavuje si i kód sám)
# KRB5CCNAME=FILE:/home/aixima/krb5cc_axima

# --- AI backend (dnes konstanty v kódu: bge-m3 + mistral-nemo) ---
# OLLAMA_URL=http://localhost:11434/api
# CHAT_MODEL=mistral-nemo
# EMBED_MODEL=bge-m3

# --- Vektorová databáze (dnes konstanty v kódu) ---
# QDRANT_URL=http://localhost:6333
# COLLECTION_NAME=axima_docs

# --- SQL Server 2019 (roadmapa: manifest, audit, hybridní hledání) ---
# SQL_CONN=DRIVER={ODBC Driver 18 for SQL Server};SERVER=10.8.2.x;DATABASE=llm_assistant;UID=llm_svc;PWD=__zmen_me__;TrustServerCertificate=yes
