[Unit]
Description=AXIMA AI Web UI (Streamlit)
After=network.target axima-api.service

[Service]
User=aixima
WorkingDirectory=/data/llm-demo/watchdog
Environment="PATH=/data/llm-demo/watchdog/venv/bin"
ExecStart=/data/llm-demo/watchdog/venv/bin/streamlit run /data/llm-demo/watchdog/web_ui.py --server.port 8501 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target